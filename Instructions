version: '3.8'

services:
  web:
    build: .
    ports:
      - "5000:5000"
    environment:
      - DEBUG=False
      - PORT=5000
      - DATABASE_URL=/app/data/clip_affiliate.db
      - AUTO_START_MONITORING=True
      - MONITORING_INTERVAL=6
    volumes:
      - ./data:/app/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5000/health"]
      interval: 30s
      timeout: 10s
      retries: 3

